# ---- LLM provider keys (comma-separate several keys per provider) ----
# Priority order is Gemini -> Groq -> OpenRouter. Keys from DIFFERENT providers give real redundancy:
# rate limits are enforced per project (Gemini) or per organisation (Groq), so extra keys on one account share one quota.
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# ---- Optional model overrides (LiteLLM model strings; free-tier model names change often) ----
# GEMINI_MODEL=gemini/gemini-2.5-flash
# GROQ_MODEL=groq/openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# ---- State (optional locally, recommended in production) ----
# Upstash / any Redis, TLS URL form: rediss://default:<password>@<host>:6379
# Used for BOTH the LiteLLM response cache and session history. Falls back to in-memory when empty.
REDIS_URL=

# ---- Web ----
# Comma-separated list of allowed browser origins. Leave empty ("*") for local development only.
ALLOWED_ORIGINS=http://localhost:3000
PORT=8000

# ---- Tuning (defaults shown) ----
# CACHE_TTL_SECONDS=3600
# SESSION_TTL_SECONDS=86400
# MAX_HISTORY_MESSAGES=20
# MAX_OUTPUT_TOKENS=2048   (reasoning models spend part of this on hidden thinking)
# COOLDOWN_SECONDS=30
# REQUEST_TIMEOUT_SECONDS=25
# RATE_LIMIT_PER_MINUTE=30

# ---- Resilience demo ----
# Adds a deliberately failing top-priority key ("demo-outage-key") that returns a real HTTP 429, so the
# failover is visible on every reply ("Answered via backup key"). Real keys are unaffected.
DEMO_OUTAGE_KEY=false
